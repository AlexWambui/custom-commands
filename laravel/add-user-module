#!/bin/bash

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;36m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  Adding/Updating User Module${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

# Check if we're in a Laravel project
if [ ! -f "artisan" ]; then
    echo -e "${RED}✗ Error: Not in a Laravel project root.${NC}"
    exit 1
fi

# Step 1: Copy User module from webapp-template
echo -e "${YELLOW}Step 1: Copying User module...${NC}"
SOURCE_MODULE="/c/Aaqil/Development/webapp-template/modules/User"
TARGET_MODULE="modules/User"

if [ ! -d "$SOURCE_MODULE" ]; then
    echo -e "${RED}✗ Source User module not found at $SOURCE_MODULE${NC}"
    exit 1
fi

# Check if modules folder exists
if [ ! -d "modules" ]; then
    echo -e "${RED}✗ modules folder not found.${NC}"
    echo -e "${YELLOW}  Make sure you've run: copy-support-module first${NC}"
    exit 1
fi

# Ask before overwriting existing User module
if [ -d "$TARGET_MODULE" ]; then
    echo -e "${YELLOW}⚠ User module already exists${NC}"
    read -p "  Overwrite with latest version? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}  Skipping User module update${NC}"
    else
        echo -e "${YELLOW}  Removing existing User module...${NC}"
        rm -rf "$TARGET_MODULE"
        cp -r "$SOURCE_MODULE" "$TARGET_MODULE"
        echo -e "${GREEN}✓ User module updated${NC}"
    fi
else
    cp -r "$SOURCE_MODULE" "$TARGET_MODULE"
    echo -e "${GREEN}✓ User module copied${NC}"
fi

# Step 2: Ensure User module is registered in Support Service Provider
echo -e "\n${YELLOW}Step 2: Ensuring User module is registered...${NC}"
SUPPORT_PROVIDER="modules/Support/Providers/SupportServiceProvider.php"

if [ ! -f "$SUPPORT_PROVIDER" ]; then
    echo -e "${RED}✗ SupportServiceProvider not found at $SUPPORT_PROVIDER${NC}"
    echo -e "${YELLOW}  Make sure you've run: copy-support-module first${NC}"
    exit 1
fi

# Check if User module is already registered
if grep -q "UserServiceProvider" "$SUPPORT_PROVIDER"; then
    echo -e "${GREEN}✓ User module already registered${NC}"
else
    # Insert the UserServiceProvider registration in the register method
    sed -i '/public function register(): void/i \    {\n        $this->app->register(\\Modules\\User\\Providers\\UserServiceProvider::class);\n    }' "$SUPPORT_PROVIDER"
    echo -e "${GREEN}✓ User module registered in SupportServiceProvider${NC}"
fi

echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ User module added/updated successfully!${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"