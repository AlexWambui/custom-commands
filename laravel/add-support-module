#!/bin/bash

# Colors for output
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;36m'
NC='\033[0m' # No Color

SOURCE_MODULE="/c/Aaqil/Development/webapp-template/modules/Support"
TARGET_MODULES="modules"

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  Copying Support Module to Project${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

# Check if we're in a Laravel project
if [ ! -f "bootstrap/providers.php" ] && [ ! -f "artisan" ]; then
    echo -e "${RED}✗ Error: Not in a Laravel project root.${NC}"
    echo -e "${YELLOW}  Make sure you're in the project root directory.${NC}"
    exit 1
fi

# Check if source module exists
if [ ! -d "$SOURCE_MODULE" ]; then
    echo -e "${RED}✗ Error: Source module not found at $SOURCE_MODULE${NC}"
    exit 1
fi

# Check if modules folder exists, if not create it
if [ ! -d "$TARGET_MODULES" ]; then
    echo -e "${YELLOW}📁 modules folder not found. Creating...${NC}"
    mkdir -p "$TARGET_MODULES"
    echo -e "${GREEN}✓ modules folder created${NC}"
fi

# Check if Support module already exists
if [ -d "$TARGET_MODULES/Support" ]; then
    echo -e "${YELLOW}⚠ Support module already exists in $TARGET_MODULES/${NC}"
    read -p "Do you want to overwrite it? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${GREEN}Operation cancelled.${NC}"
        exit 0
    fi
    echo -e "${YELLOW}Removing existing Support module...${NC}"
    rm -rf "$TARGET_MODULES/Support"
fi

# Copy the Support module
echo -e "${YELLOW}📁 Copying Support module...${NC}"
cp -r "$SOURCE_MODULE" "$TARGET_MODULES/"

if [ $? -eq 0 ]; then
    echo -e "${GREEN}✓ Support module copied successfully!${NC}"
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  Support Module Structure:${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    ls -la "$TARGET_MODULES/Support/"
    echo -e "\n${GREEN}✓ Done! Next step:${NC}"
    echo -e "  1. Add the provider to bootstrap/providers.php"
    echo -e "  2. Run: ${YELLOW}add-support-provider${NC}"
else
    echo -e "${RED}✗ Error: Failed to copy Support module${NC}"
    exit 1
fi